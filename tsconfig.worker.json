{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/worker/**/*.ts",
    "src/shared/**/*.ts",
    "worker-configuration.d.ts",
    "node_modules/@cloudflare/vitest-pool-workers/types/cloudflare-test.d.ts"
  ]
}
